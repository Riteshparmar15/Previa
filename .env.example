# ===================================================================
# Previa Preschool AI Assistant — Environment Configuration Template
# ===================================================================

# Environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Database Selection: SQLite (default for fast dev) | MySQL (production)
DATABASE_PROVIDER=SQLite

# MySQL Connection String (Used when DATABASE_PROVIDER=MySQL)
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=previa;User=previa_user;Password=ChangeThisSecurePassword!2026;CharSet=utf8mb4;"

# JWT Authentication
JwtSettings__Secret="PreviaSuperSecureSecretKey_ReplaceInProductionWithAtLeast32BytesLengthKey!"
JwtSettings__Issuer="PreviaAuth"
JwtSettings__Audience="PreviaPreschoolSaaS"
JwtSettings__ExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=7

# External AI Provider (Optional)
# Supported Providers: OpenAI, Anthropic, Gemini, DeepSeek
# Leave ApiKey empty to use Previa's built-in offline Gujarati/Hindi/English educational synthesis engine
AiSettings__Provider="OpenAI"
AiSettings__ApiKey=""
AiSettings__Model="gpt-4o-mini"
AiSettings__BaseUrl="https://api.openai.com/v1"

# Client Frontend Proxy Settings
VITE_API_URL="http://localhost:5123"
